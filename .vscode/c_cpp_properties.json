{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "kernel",
                ".",
                ".."
            ],
            "defines": [
                "${default}",
                "SMP",
                "DEBUG",
                "__i686__",
                "nullptr=NULL"
            ],
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${default}",
                "path": [
                    "${default}"
                ]
            },
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "${default}",
            "cppStandard": "${default}",
            "compilerPath": "${default}"
        }
    ],
    "version": 4
}